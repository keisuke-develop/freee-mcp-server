# ローカル実行・テスト用の環境変数の例
# 実際の値は .env に書く（.env は .gitignore で除外済み）
#
# 本番（Lambda）では、認証情報は環境変数ではなく
# AWS Secrets Manager に格納する。理由は docs/security.md を参照。

# Secrets Manager のシークレット名（値そのものではなくポインタ）
SECRET_NAME=freee/mcp-server

# AWS リージョン
AWS_REGION=ap-northeast-1

# ログレベル
LOG_LEVEL=INFO

# freee API のベースURL
FREEE_API_BASE_URL=https://api.freee.co.jp

# --- 以下は絶対にここに書かない（Secrets Manager に格納する） ---
# CLIENT_SECRET=
# REFRESH_TOKEN=
# ACCESS_TOKEN=
